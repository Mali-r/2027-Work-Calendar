# MongoDB Atlas connection string (create a free cluster at https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smartworkcalendar2027?retryWrites=true&w=majority

# Long random secret used to sign login tokens (JWT). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Port the server listens on (Render sets this automatically; safe to leave as-is)
PORT=4000

# The URL of your deployed frontend (Vercel), used for CORS. Use * only for quick local testing.
CORS_ORIGIN=https://your-frontend.vercel.app

# Optional: if set, anyone registering a new account must supply this code.
# Leave blank to allow open registration (fine for a small trusted team).
REGISTER_CODE=

# Admin account created automatically by npm start or npm run seed.
# Change the password before using this in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
